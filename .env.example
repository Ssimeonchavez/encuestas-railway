# Configuración de entorno para MySQL
# Copia este archivo a .env y actualiza con tus credenciales reales.
# En Railway, el servicio MySQL provee MYSQL_URL automáticamente.

SECRET_KEY=tu_clave_secreta_aqui
# Ejemplo local:
# MYSQL_URL=mysql://root:password@localhost:3306/encuestas
MYSQL_URL=mysql://usuario:password@host:3306/encuestas
